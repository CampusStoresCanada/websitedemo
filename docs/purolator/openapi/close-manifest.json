{
  "openapi": "3.0.3",
  "info": {
    "description": "Close manifest API\n\n\n## Authentication\n\n\nThis API requires **Bearer Token** authentication. Include your token in the\n`Authorization` header:\n\n\n```\n\nAuthorization: Bearer <your-token>\n\n```\n\n\nAll endpoints also require an `x-api-key` header.",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "title": "Close Manifest",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "https://shipapi.purolator.com"
    },
    {
      "url": "https://shipapi-sandbox.purolator.com"
    }
  ],
  "tags": [
    {
      "name": "Close Manifest",
      "description": "Close manifest endpoint"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/ship/v1/manifest": {
      "post": {
        "tags": [
          "Close Manifest"
        ],
        "summary": "Close manifest",
        "description": "Trigger end-of-day close (consolidate) of the courier manifest for an account. Freight is not supported.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-api-key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "x-api-key"
          },
          {
            "in": "header",
            "name": "Language",
            "schema": {
              "$ref": "#/components/schemas/Language"
            },
            "required": false
          },
          {
            "in": "header",
            "name": "RequestReference",
            "schema": {
              "$ref": "#/components/schemas/RequestReference"
            },
            "required": false
          }
        ],
        "requestBody": {
          "description": "Account and line of business for close manifest.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CloseManifestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Manifest closed successfully.",
            "headers": {
              "Language": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              },
              "RequestReference": {
                "schema": {
                  "$ref": "#/components/schemas/RequestReference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloseManifestResponse"
                },
                "example": {
                  "language": "en",
                  "requestReference": "d7173d5c-1b5d-4883-a6f0-5f77456ebf6e",
                  "shipmentsConsolidated": "true"
                }
              }
            }
          },
          "400": {
            "description": "An error based on user input occurred.",
            "headers": {
              "Language": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              },
              "RequestReference": {
                "schema": {
                  "$ref": "#/components/schemas/RequestReference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "requestReference": "d7173d5c-1b5d-4883-a6f0-5f77456ebf6e",
                  "language": "en",
                  "errors": [
                    {
                      "error": {
                        "code": "9001-04",
                        "description": "The line of business is a mandatory field."
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed.",
            "headers": {
              "Language": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              },
              "RequestReference": {
                "schema": {
                  "$ref": "#/components/schemas/RequestReference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "requestReference": "d7173d5c-1b5d-4883-a6f0-5f77456ebf6e",
                  "language": "en",
                  "errors": [
                    {
                      "error": {
                        "code": "9001-09",
                        "description": "Account number '3223557' is invalid"
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "An internal server error occurred.",
            "headers": {
              "Language": {
                "schema": {
                  "$ref": "#/components/schemas/Language"
                }
              },
              "RequestReference": {
                "schema": {
                  "$ref": "#/components/schemas/RequestReference"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "requestReference": "d7173d5c-1b5d-4883-a6f0-5f77456ebf6e",
                  "language": "en",
                  "errors": [
                    {
                      "error": {
                        "code": "9001-01",
                        "description": "There is an unknown internal server error. Please try again later."
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Language": {
        "type": "string",
        "enum": [
          "EN",
          "FR"
        ],
        "default": "EN",
        "description": "Response language. Case-insensitive. If not provided, defaults to EN (English).",
        "example": "EN"
      },
      "RequestReference": {
        "type": "string",
        "maxLength": 36,
        "description": "A unique identifier for the request. Can be used to match request with the response. If not provided, a random UUID is generated.",
        "example": "d7173d5c-1b5d-4883-a6f0-5f77456ebf6e"
      },
      "LineOfBusiness": {
        "type": "string",
        "enum": [
          "Courier",
          "Freight"
        ],
        "description": "Line of business. Case-insensitive. Only Courier is supported.",
        "example": "Courier"
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code",
            "example": "9001-04"
          },
          "description": {
            "type": "string",
            "description": "Detailed error description in the requested language.",
            "example": "The line of business is a mandatory field."
          }
        }
      },
      "ErrorItem": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "requestReference": {
            "$ref": "#/components/schemas/RequestReference"
          },
          "language": {
            "type": "string",
            "example": "en"
          },
          "bannerMessages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional informational banners."
          },
          "errors": {
            "type": "array",
            "description": "Array of shipping errors.",
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            }
          }
        }
      },
      "CloseManifestRequest": {
        "type": "object",
        "required": [
          "lineOfBusiness",
          "accountNumber"
        ],
        "properties": {
          "lineOfBusiness": {
            "$ref": "#/components/schemas/LineOfBusiness"
          },
          "accountNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "example": "3223557",
            "description": "Account number whose manifest should be closed."
          },
          "requestReference": {
            "$ref": "#/components/schemas/RequestReference"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          }
        }
      },
      "CloseManifestResponse": {
        "type": "object",
        "required": [
          "language",
          "requestReference",
          "shipmentsConsolidated"
        ],
        "properties": {
          "language": {
            "type": "string",
            "example": "en"
          },
          "requestReference": {
            "$ref": "#/components/schemas/RequestReference"
          },
          "shipmentsConsolidated": {
            "type": "string",
            "enum": [
              "true",
              "false"
            ],
            "example": "true"
          },
          "bannerMessage": {
            "type": "string",
            "description": "Included only when non-empty."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorItem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "For secure access, this API uses Bearer Authentication (also known as token authentication). You must send a Bearer token in the Authorization header when making requests to protected endpoints. The token should be prefixed with the word \"Bearer\" followed by a space. Example: \"Authorization: Bearer <YourTokenHere>\"."
      }
    }
  }
}