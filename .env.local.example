# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Mapbox (add when ready)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Giphy (powers GIF picker in rich text editor — get a free key at developers.giphy.com)
NEXT_PUBLIC_GIPHY_API_KEY=your_giphy_api_key_here

# Supabase service role (for webhooks / background jobs — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Storage-upload login for scripts/upload-product-images.mjs. A real account's
# email and password: keep them here, never in the script. This repo is public
# and a credential committed once stays in history even after it is rotated.
SUPABASE_UPLOAD_EMAIL=account_with_storage_write_access
SUPABASE_UPLOAD_PASSWORD=its_password

# Content encryption (for gated data payloads)
CONTENT_ENCRYPTION_SECRET=generate_with_openssl_rand_base64_32

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email intercept — redirect ALL outgoing email to this address during development.
# The original recipient appears in the subject as [DEV → original@email.com].
# Leave unset in production.
DEV_EMAIL_INTERCEPT=you@example.com
